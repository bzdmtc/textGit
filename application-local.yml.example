# 本地开发私有配置示例
# 复制为 application-local.yml（已在 .gitignore 中忽略），填入自己的本地/测试环境值。
# 也可以用环境变量覆盖：DB_MASTER_PASSWORD / DB_READ_PASSWORD / REDIS_PASSWORD / JWT_SECRET。
spring:
  data:
    redis:
      password: your-redis-password

app:
  datasource:
    master:
      password: your-master-db-password
    read:
      password: your-read-db-password
  # Base64 编码的 HMAC 密钥，解码后至少 32 字节。
  # 生成示例：openssl rand -base64 32
  jwt:
    secret: your-base64-encoded-jwt-secret-at-least-32-bytes
